# Copy to .env and fill in. ./deploy.sh exports this file before every
# command; docker stack deploy itself never reads it.

# Stack name; also the prefix of this stack's swarm secrets.
STACK_NAME=preview-govtool
BASE_DOMAIN=preview.gov.tools
APP_ENV=preview

# Image tag published by CI: dev (develop), test, latest (main), a vX.Y.Z tag
# or a commit sha. Pin a sha or version to make a deploy reproducible.
GOVTOOL_TAG=dev
IMAGE_REGISTRY=ghcr.io/intersectmbo

# Swarm networks this stack joins; both must already exist.
# The nginx-proxy gateway's network.
GATEWAY_NETWORK=frontend
# The Postgres the metadata service stores into (the proposal stack's).
METADATA_DB_NETWORK=preview-proposal_postgres

# Chain data: dbsync, koios, blockfrost or fixture.
CHAIN_DATA_PROVIDER=dbsync
# db-sync's Postgres, reachable from the backend container. The password is
# the swarm secret ${STACK_NAME}_dbsync_password (./deploy.sh secrets).
DBSYNC_POSTGRES_HOST=
DBSYNC_POSTGRES_PORT=5432
DBSYNC_DATABASE=
DBSYNC_POSTGRES_USER=
# mainnet, preprod, preview or devnet; must match the database, or every route
# answers 500.
DBSYNC_NETWORK=preview
# 0 testnet, 1 mainnet; must agree with DBSYNC_NETWORK.
NETWORK_FLAG=0

# Proposal discussion (pdf) API, used by the frontend and by the backend's
# outcomes route linking an action to its discussion.
PDF_API_URL=https://pdf.preview.gov.tools/api

IPFS_GATEWAY=https://ipfs.io/ipfs
IPFS_PROJECT_ID=
# Optional: your own IPFS gateway, tried by the metadata service first.
IPFS_PRIMARY_GATEWAY=

SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

PROPOSAL_DISCUSSION_FORUM_ENABLED=true
GOVERNANCE_OUTCOMES_PILLAR_ENABLED=true
CIP179_ENABLED=true

# Optional integrations; both Umami values or neither.
CHATWOOT_URL=
CHATWOOT_WEBSITE_TOKEN=
UMAMI_URL=
UMAMI_WEBSITE_ID=

# ./deploy.sh init-metadata-db: the proposal stack's Postgres service, the
# superuser to run as inside it, and the host name the metadata service uses
# for it on METADATA_DB_NETWORK.
METADATA_DB_SERVICE=preview-proposal_postgres
METADATA_DB_SUPERUSER=postgres
METADATA_DB_HOST=postgres
