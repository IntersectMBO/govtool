# Settings for the isolated devnet test environment (tests/devnet).
#
# Read by docker-compose.yml (through up.sh/down.sh), up.sh, down.sh, seed.sh
# and run-tests.sh. Everything here is devnet-only: no value is a real
# secret. Put local overrides in .env.devnet.local (gitignored), which is
# read after this file; variables already set in the environment win over
# both.

COMPOSE_PROJECT_NAME=govtool-devnet

# --- Chain side (adaup `cardano devnet --docker`) ---------------------------

# The adaup CLI (pip install adaup). Point it at a virtualenv's bin/cardano
# when it is not on PATH.
ADAUP_CARDANO=cardano

# adaup reads its ADAUP_DEVNET_* settings from the environment; the ones
# below matter to the tests. Timings: 0.2 s slots and 300-slot epochs give
# 60 s epochs. Proposals and DRep activity last ADAUP_DEVNET_LIVE_SECONDS of
# wall-clock time (as a number of epochs). 48 h: the frontend shows expiry
# as a date, and Playwright 4H checks that date is not before today, so a
# seeded proposal must expire on a later calendar day than the run.
ADAUP_DEVNET_DIR=${HOME}/.cardano/devnet-docker
ADAUP_DEVNET_PROJECT=adaup-devnet
ADAUP_DEVNET_SLOT_LENGTH=0.2
ADAUP_DEVNET_EPOCH_LENGTH=300
ADAUP_DEVNET_LIVE_SECONDS=172800
ADAUP_DEVNET_KUBER_PORT=8081
ADAUP_DEVNET_POSTGRES_PORT=5433
ADAUP_DEVNET_ANCHOR_PORT=8090

# The devnet's output directory and Docker network (adaup names the network
# after its project).
DEVNET_OUTPUT_DIR=${ADAUP_DEVNET_DIR}
DEVNET_DOCKER_NETWORK=${ADAUP_DEVNET_PROJECT}

# The funded faucet's cardano-cli signing key, relative to DEVNET_OUTPUT_DIR
# unless absolute. It is a payment key alone; scripts/faucet-env.js generates
# a stake key and moves the funds to the resulting base address.
FAUCET_SKEY_FILE=keys/faucet/payment.skey
FAUCET_STAKE_SKEY_FILE=

# Kuber, as the app containers reach it and as the host reaches it.
KUBER_INTERNAL_URL=http://kuber:8081
KUBER_URL=http://127.0.0.1:${ADAUP_DEVNET_KUBER_PORT}

# db-sync's Postgres on the devnet network.
DBSYNC_HOST=postgres
DBSYNC_PORT=5432
DBSYNC_DATABASE=cexplorer
DBSYNC_USER=postgres
DBSYNC_PASSWORD=postgres

# Chain seed (seed.sh): two `cardano devnet smoke` rounds. The first ratifies
# DEVNET_SEED_RATIFY and waits for enactment (outcomes data); the second
# ratifies nothing, so one proposal of every type stays live for the whole
# run. The order matters: an enactment removes live proposals of the same
# purpose, so the live round must come after the enacted one.
DEVNET_SEED_ACTIONS=info,treasury,parameter,hardfork,no-confidence,committee,constitution
DEVNET_SEED_RATIFY=treasury,parameter,committee,constitution
# Extra treasury withdrawals enacted in round 1, so the outcomes list has
# more than one page (12 per page; Playwright 9F clicks "Show more").
DEVNET_SEED_EXTRA_TREASURY=10

# --- App side ----------------------------------------------------------------

# Host ports, all bound to loopback.
FRONTEND_PORT=8080
BACKEND_PORT=9999
PDF_PORT=1337
BLOCKFROST_SHIM_PORT=3100
METADATA_BUCKET_PORT=3001

# The test metadata bucket (tests/test-metadata-api): anchor uploads, IPFS
# pinning and the IPFS gateway (/ipfs/<cid>). One URL must work from the host
# (Playwright uploads anchors, the browser opens ipfs links) and from the
# containers (metadata service, backend, pdf backend and db-sync fetch them),
# so the bucket listens on the same port inside and out, under a name that
# is a network alias inside Docker and resolves to loopback on the host
# (*.localhost does on macOS and with systemd-resolved; Chromium always).
METADATA_BUCKET_HOST=metadata-bucket.localhost
METADATA_BUCKET_URL=http://${METADATA_BUCKET_HOST}:${METADATA_BUCKET_PORT}
IPFS_GATEWAY_URL=${METADATA_BUCKET_URL}/ipfs

# db-sync resolves ipfs:// anchors through the bucket too (adaup writes it
# into db-sync's ipfs_gateway setting).
ADAUP_DEVNET_IPFS_GATEWAYS=${IPFS_GATEWAY_URL}

# Browser-facing URLs baked into the frontend's runtime config.
PUBLIC_FRONTEND_URL=http://127.0.0.1:${FRONTEND_PORT}
PUBLIC_BACKEND_URL=http://127.0.0.1:${BACKEND_PORT}
PUBLIC_PDF_URL=http://127.0.0.1:${PDF_PORT}

# Frontend image: Dockerfile (the production build from source; needs about
# 8 GB of Docker memory) or ../../tests/devnet/frontend/prebuilt.Dockerfile
# (serves govtool/frontend/dist from a host `npm run build`).
FRONTEND_DOCKERFILE=Dockerfile

# pdf backend JWT secrets: devnet-only placeholders, at least 32 characters.
PDF_JWT_SECRET=devnet-only-access-secret-0123456789abcdef
PDF_REFRESH_SECRET=devnet-only-refresh-secret-0123456789abcd
