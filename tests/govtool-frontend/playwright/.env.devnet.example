# Playwright against the isolated devnet (tests/devnet). tests/devnet/up.sh
# writes these values, faucet keys included, to tests/devnet/.state/playwright.env;
# export that file before running:
#
#   set -a; . ../../devnet/.state/playwright.env; set +a
#   npx playwright test --project=...
#
# Exported variables win over this directory's .env (dotenv never overwrites).
# The values below are the defaults from tests/devnet/.env.devnet.

HOST_URL=http://127.0.0.1:8080
NETWORK=devnet

# Devnet Kuber, no API key.
KUBER_URL=http://127.0.0.1:8081
KUBER_API_KEY=

# The Blockfrost shim (tests/devnet/blockfrost-shim); the key is ignored.
BLOCKFROST_URL=http://127.0.0.1:3100/api
BLOCKFROST_API_KEY=devnet

# The local metadata bucket; the same URL must resolve from the containers.
CARDANOAPI_METADATA_URL=http://metadata-bucket.localhost:3001

# Test wallets are HD accounts of this mnemonic (npm run generate-test-mnemonic).
TEST_WALLET_MNEMONIC=

# From tests/devnet/scripts/faucet-env.js (devnet keys only).
FAUCET_ADDRESS=
FAUCET_PAYMENT_PRIVATE=
FAUCET_STAKE_PRIVATE=

TX_TIMEOUT=120000
IS_HARDFORK_PROPOSAL_ENABLED=true
CI=true
TEST_WORKERS=4
