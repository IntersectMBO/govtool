# Example host nginx server block for govtool2.
# Replace docs.dev.gov.tools with the temporary hostname (later: docs.gov.tools)
# and point the certificate paths at your certificate (e.g. Let's Encrypt or a
# Cloudflare origin certificate).

server {
    listen 80;
    listen [::]:80;
    server_name docs.dev.gov.tools;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name docs.dev.gov.tools;

    ssl_certificate     /etc/ssl/certs/docs.dev.gov.tools.pem;
    ssl_certificate_key /etc/ssl/private/docs.dev.gov.tools.key;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
