# Image to run (set to the tag you published).
DOCS_IMAGE=ghcr.io/intersectmbo/govtool-docs:dev
# Host port the container is published on (bound to 127.0.0.1 only).
DOCS_PORT=8085
# Keep temporary hosts out of search engines. Set to "all" once the site is
# served as the official docs.gov.tools.
X_ROBOTS_TAG=noindex, nofollow
