DATABASE_URL=file:./dev.db
# Optional: comma-separated IPFS gateways replacing the default public list
# (src/config.ts). IPFS_PRIMARY_GATEWAY, when set, is tried before them.
# IPFS_GATEWAYS=
# IPFS_PRIMARY_GATEWAY=

# Local testing only (D137): allow fetching metadata from loopback/private
# addresses, e.g. a local test bucket. Never set this in a deployment.
# METADATA_ALLOW_PRIVATE_ADDRESSES=true
