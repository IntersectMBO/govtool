# Which implementation of the chain-data contract to construct: dbsync, koios,
# blockfrost or fixture. The GOVTOOL_DBSYNC_ group below is read only when
# this is dbsync, so a Koios or Blockfrost deployment needs no database at all.
#
# `fixture` reads a frozen mainnet capture out of the package — no network, no
# database, no credentials — and is the one to use for local development.
GOVTOOL_CHAIN_DATA_PROVIDER=dbsync

GOVTOOL_DBSYNC_HOST=Host
GOVTOOL_DBSYNC_PORT=Port number
# mainnet (default), preprod, preview or devnet: the network the db-sync
# database follows. devnet is any custom local testnet (network id 0).
GOVTOOL_DBSYNC_NETWORK=mainnet
GOVTOOL_DBSYNC_DATABASE=database_name
GOVTOOL_DBSYNC_USER=database_user
GOVTOOL_DBSYNC_PASSWORD=password
# devnet only: the Shelley genesis file db-sync was started with. Proposal
# expiry dates come from its systemStart, epochLength and slotLength; it is
# checked against db-sync's meta.start_time. Unset: those dates are null.
GOVTOOL_DBSYNC_SHELLEY_GENESIS_PATH=
# Optional: the meta.network_name db-sync must report. Unset: the network
# name on a public network, any non-public name on devnet.
GOVTOOL_DBSYNC_NETWORK_NAME=

# Koios. The network alone is enough; a token only raises the rate limit, and
# the base URL is for a self-hosted instance.
GOVTOOL_KOIOS_NETWORK=mainnet
GOVTOOL_KOIOS_TOKEN=
GOVTOOL_KOIOS_BASE_URL=

# Blockfrost. The base URL is required when this provider is selected.
GOVTOOL_BLOCKFROST_BASE_URL=
GOVTOOL_BLOCKFROST_PROJECT_ID=

GOVTOOL_PINATA_API_JWT=
# Anonymous /ipfs/upload budgets: per client IP, and for the whole instance
GOVTOOL_IPFS_UPLOAD_PER_CLIENT_LIMIT=10
GOVTOOL_IPFS_UPLOAD_GLOBAL_LIMIT=300
GOVTOOL_IPFS_UPLOAD_WINDOW_SECONDS=3600
# Proxies trusted to report the client IP (Express "trust proxy")
GOVTOOL_TRUST_PROXY=loopback, linklocal, uniquelocal
# pinata (default) or test. test pins to the local test metadata service
# (tests/test-metadata-api) at GOVTOOL_TEST_PINNING_URL, e.g.
# http://test-metadata-api:3000, for isolated test environments only.
GOVTOOL_PINNING_PROVIDER=pinata
GOVTOOL_TEST_PINNING_URL=

# Base url of the proposal discussion (pdf) API, such as
# http://pdf-backend:1337/api. Only the governance action route linking an action to its
# discussion uses it; it answers 503 when unset.
GOVTOOL_PDF_API_URL=

# Root url of the private metadata service (govtool-metadata-service), such as
# http://metadata:3000. Only the backend should be able to reach it. Leave
# empty to run without it: GET /metadata/resolve, POST /metadata/retry and the
# /metadata/reports routes then answer 503.
GOVTOOL_METADATA_SERVICE_URL=
# Local testing only (D137): let the backend's own metadata fetch reach loopback
# and private addresses. Never set this in a deployment.
GOVTOOL_METADATA_ALLOW_PRIVATE_URLS=false
GOVTOOL_SENTRY_DSN=https://username:password@senty.host/id

# IPFS gateway base URL, including /ipfs when the provider requires it
IPFS_GATEWAY=
IPFS_PROJECT_ID=
GOVTOOL_CACHE_MAX_ENTRIES=256
