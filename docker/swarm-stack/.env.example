# Copy to .env and fill in, then export before deploying:
#   set -a; . ./.env; set +a
# Secrets are exported separately (see the bottom of this file) and never
# stored here.

# Stack name for `docker-stack deploy`.
STACK_NAME=preview-govtool
BASE_DOMAIN=preview.gov.tools
APP_ENV=preview

# Image tag published by CI: dev (develop), test, latest (main), a vX.Y.Z tag
# or a commit sha. Pin a sha or version to make a deploy reproducible.
GOVTOOL_TAG=dev
IMAGE_REGISTRY=ghcr.io/intersectmbo

# The nginx-proxy gateway's Swarm network; it must already exist.
GATEWAY_NETWORK=frontend
# Where the stack's Postgres runs. Its data is a local volume, so on a swarm
# with more than one node labelled govtool, pin it to one, e.g.
# node.hostname == govtool1. Empty: any node labelled govtool.
POSTGRES_NODE_CONSTRAINT=

# Chain data: dbsync, koios, blockfrost or fixture.
CHAIN_DATA_PROVIDER=dbsync
# db-sync's Postgres, reachable from the backend container. The password is
# exported separately as DBSYNC_PASSWORD (see the bottom of this file).
DBSYNC_POSTGRES_HOST=
DBSYNC_POSTGRES_PORT=5432
DBSYNC_DATABASE=
DBSYNC_POSTGRES_USER=
# mainnet, preprod, preview or devnet; must match the database, or every route
# answers 500.
DBSYNC_NETWORK=preview
# 0 testnet, 1 mainnet; must agree with DBSYNC_NETWORK.
NETWORK_FLAG=0
# With CHAIN_DATA_PROVIDER=koios: mainnet, preprod, preview or guild. Leave
# KOIOS_BASE_URL empty for that network's public Koios. An API token, if
# any, is exported separately as KOIOS_TOKEN.
KOIOS_NETWORK=preview
KOIOS_BASE_URL=
# With CHAIN_DATA_PROVIDER=blockfrost: mainnet, preprod, preview or devnet.
# Leave BLOCKFROST_BASE_URL empty for hosted Blockfrost, which needs a
# project id exported separately as BLOCKFROST_PROJECT_ID; devnet and a
# self-hosted blockfrost-ryo need the base url.
BLOCKFROST_NETWORK=preview
BLOCKFROST_BASE_URL=

IPFS_GATEWAY=https://ipfs.io/ipfs
IPFS_PROJECT_ID=
# Optional: your own IPFS gateway, tried by the metadata service first.
IPFS_PRIMARY_GATEWAY=

SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

PROPOSAL_DISCUSSION_FORUM_ENABLED=true
CIP179_ENABLED=true

# Optional integrations; both Umami values or neither.
CHATWOOT_URL=
CHATWOOT_WEBSITE_TOKEN=
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Secrets: export in the deploying shell, never store here. docker-stack
# resolves them at deploy time and versions them, so changed values roll out
# without touching anything by hand.
#   read -r -s -p "db-sync Postgres password: " DBSYNC_PASSWORD; echo; export DBSYNC_PASSWORD  # required with dbsync
#   read -r -s -p "Koios API token (empty: public tier): " KOIOS_TOKEN; echo; export KOIOS_TOKEN  # optional, koios only
#   read -r -s -p "Blockfrost project id: " BLOCKFROST_PROJECT_ID; echo; export BLOCKFROST_PROJECT_ID  # hosted blockfrost only
#   read -r -s -p "Pinata API JWT (empty: no /ipfs/upload): " PINATA_API_JWT; echo; export PINATA_API_JWT  # optional
#   export POSTGRES_PASSWORD="$(openssl rand -hex 32)"  # the stack's Postgres superuser; keep it
#   export METADATA_DB_PASSWORD="$(openssl rand -hex 32)" PDF_DB_PASSWORD="$(openssl rand -hex 32)"  # app roles, created on the first deploy; keep them
#   export PDF_JWT_SECRET="$(openssl rand -hex 32)" PDF_REFRESH_SECRET="$(openssl rand -hex 32)"  # forum sign-in; keep them, a new value signs everyone out
