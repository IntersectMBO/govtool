DBSYNC_POSTGRES_HOST=
DBSYNC_POSTGRES_PORT=
DBSYNC_POSTGRES_USER=
DBSYNC_POSTGRES_PASSWORD=
DBSYNC_DATABASE=
# mainnet, preprod, preview or devnet; must match the database
DBSYNC_NETWORK=preview
PDF_API_URL=""
IPFS_GATEWAY="https://ipfs.io/ipfs"
# Optional: enables /ipfs/upload
PINATA_API_JWT=
# Required: password of the metadata service's Postgres (metadata-db). Long,
# random and URL-safe, as it goes into DATABASE_URL: openssl rand -hex 32
METADATA_DB_PASSWORD=
# Optional: your own IPFS gateway, tried before the public ones.
IPFS_PRIMARY_GATEWAY=
