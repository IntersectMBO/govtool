# Every variable of SPEC §10, with its default. Used by `npm run start:dev`,
# `npm run prisma:*` and `npm run seed:demo` outside Docker; docker-compose.yml
# sets its own. Invalid values stop the process with a message naming the
# variable.

# Required. Postgres from docker-compose.yml, published on the host.
DATABASE_URL=postgresql://pdf:pdf@127.0.0.1:5442/pdf?schema=public
# e2e only (npm run test:e2e); the suite refuses any name not ending in _test.
DATABASE_URL_TEST=postgresql://pdf:pdf@127.0.0.1:5442/pdf_test?schema=public

HOST=0.0.0.0
PORT=1337

# Required, at least 32 characters each, and different. Development values
# only: generate real ones with `openssl rand -hex 32`.
JWT_SECRET=dev-only-access-secret-change-me-0123456789
REFRESH_SECRET=dev-only-refresh-secret-change-me-012345678
JWT_SECRET_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=7d

# lax | strict | none. none forces Secure and requires an explicit CORS_ORIGINS.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false

CHALLENGE_TTL_SECONDS=300

# * reflects any origin (never sent as *); otherwise comma-separated exact
# origins, e.g. http://localhost:8080,https://gov.tools
CORS_ORIGINS=*

# 0 or 1; unset accepts both networks.
CARDANO_NETWORK_ID=

# GovTool backend for GET /api/proxy/govtool/<path>, e.g. http://127.0.0.1:9999
GOVTOOL_API_BASE_URL=
GOVTOOL_PROXY_ALLOWED_PATHS=proposal/enacted-details

PROXY_TIMEOUT_MS=10000
PROXY_MAX_BYTES=5242880
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
# Test switch only. Never set in a deployment.
PDF_ALLOW_PRIVATE_URLS=false
# Test only, needs PDF_ALLOW_PRIVATE_URLS=true: connect elsewhere for these
# host:port pairs, e.g. 127.0.0.1:3001=host.docker.internal:3001 in Docker.
PDF_PROXY_HOST_REWRITES=

BODY_LIMIT=1mb
