# Which implementation of the chain-data contract to construct: dbsync, koios
# or blockfrost. The VVA_DBSYNCCONFIG_ group below is read only when this is
# dbsync, so a Koios or Blockfrost deployment needs no database at all.
VVA_CHAINDATAPROVIDER=dbsync

VVA_DBSYNCCONFIG_HOST=Host
VVA_DBSYNCCONFIG_PORT=Port number
VVA_DBSYNCCONFIG_DBNAME=database_name
VVA_DBSYNCCONFIG_USER=database_user
VVA_DBSYNCCONFIG_PASSWORD=password

# Koios. The network alone is enough; a token only raises the rate limit, and
# the base URL is for a self-hosted instance.
VVA_KOIOSNETWORK=mainnet
VVA_KOIOSTOKEN=
VVA_KOIOSBASEURL=

# Blockfrost. The base URL is required when this provider is selected.
VVA_BLOCKFROSTBASEURL=
VVA_BLOCKFROSTPROJECTID=

VVA_PINATAAPIJWT=
VVA_SENTRYDSN=https://username:password@senty.host/id

# IPFS gateway base URL, including /ipfs when the provider requires it
IPFS_GATEWAY=
IPFS_PROJECT_ID=
VVA_CACHEMAXENTRIES=256
