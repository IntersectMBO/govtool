--- /dev/null
+++ .gitignore
@@ -0,0 +1,28 @@
+# Environment files
+.env
+.env.local
+.env.*.local
+
+# Secret / credential files
+*.pem
+*.key
+*.p12
+*.pfx
+secrets.json
+secrets.yaml
+secrets.yml
+
+# SSH keys
+id_rsa
+id_rsa.*
+id_ed25519
+id_ed25519.*
+
+# Cloud credentials
+.aws/credentials
+.gcp/credentials.json
+.azure/credentials
+
+# Build artifacts
+node_modules/
+dist/
+build/
+.next/
+coverage/
+
+# Misc
+.DS_Store
+*.log
+.secrets.baseline